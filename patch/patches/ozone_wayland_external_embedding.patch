+#define UI_OZONE_PLATFORM_WAYLAND_HOST_WAYLAND_EMBEDDED_WINDOW_H_
+
+#include "base/memory/weak_ptr.h"
+#include "ui/ozone/platform/wayland/host/wayland_window.h"
+#include "ui/platform_window/platform_window_init_properties.h"
+
+struct wl_surface;
+
+namespace ui {
+
+class WaylandConnection;
+
+// A WaylandWindow implementation that embeds a CEF browser into an external
+// application's wl_surface (CEF issue #2804). Like WaylandBubble it is backed
+// by a wl_subsurface, but its parent is a raw wl_surface* owned by the
+// embedding application rather than a Chromium WaylandWindow. The embedder and
+// CEF must share the same wl_display (see
+// OzonePlatform::SetExternalWaylandDisplayForEmbedding()).
+//
+// Unlike WaylandBubble, this window does NOT commit the parent surface: the
+// embedder owns and drives that surface. Subsurface position/state changes are
+// latched when the embedder next commits its own surface.
+class WaylandEmbeddedWindow final : public WaylandWindow {
+ public:
+  WaylandEmbeddedWindow(PlatformWindowDelegate* delegate,
+                        WaylandConnection* connection);
+  WaylandEmbeddedWindow(const WaylandEmbeddedWindow&) = delete;
+  WaylandEmbeddedWindow& operator=(const WaylandEmbeddedWindow&) = delete;
+  ~WaylandEmbeddedWindow() override;
+
+  wl_surface* external_parent_surface() const {
+    return external_parent_surface_;
+  }
+
+  // PlatformWindow overrides:
+  void Show(bool inactive) override;
+  void Hide() override;
+  void Close() override;
+  bool IsVisible() const override;
+  void SetBoundsInDIP(const gfx::Rect& bounds) override;
+
+  // WaylandWindow overrides:
+  void OnSequencePoint(int64_t seq) override;
+  void AckConfigure(uint32_t serial) override {}
+  base::WeakPtr<WaylandWindow> AsWeakPtr() override;
+  void UpdateWindowScale(bool update_bounds) override;
+  // A wl_subsurface does not receive wp_fractional_scale_v1 preferred_scale, so
+  // the base class's raw preferred scale is null and the aura/viz device scale
+  // factor (WaylandScreen::GetPreferredScaleFactorForAcceleratedWidget) would
+  // default to 1.0 -- making the browser render at 1x and the compositor
+  // upscale it (blurry). Return the effective embedded scale instead so viz
+  // renders at the fractional scale (crisp). See CEF issue #2804.
+  std::optional<float> GetPreferredScaleFactor() const override;
+
+ private:
+  // WaylandWindow overrides:
+  bool OnInitialize(PlatformWindowInitProperties properties,
+                    PlatformWindowDelegate::State* state) override;
+  bool IsSurfaceConfigured() override;
+  void UpdateWindowMask() override;
+
+  // Creates the wl_subsurface parented to |external_parent_surface_| and marks
+  // the window configured (subsurfaces receive no configure events).
+  bool CreateSubsurface();
+  void SetSubsurfacePosition();
+
+  // The fractional scale to render this embedded window at: the compositor's
+  // per-surface preferred scale (wp_fractional_scale_v1) if known, else the
+  // primary output's fractional scale. Used with wp_viewport for crisp,
+  // 1:1-with-physical rendering. Returns 1.0 if no output is available yet.
+  float EmbeddedScale() const;
+
+  // Externally-owned parent surface. Not owned; kept alive by the embedder.
+  raw_ptr<wl_surface, DisableDanglingPtrDetection> external_parent_surface_ =
+      nullptr;
+
+  // Offset (in DIP) of the subsurface within |external_parent_surface_|, i.e.
+  // where the browser sits inside the host's content area (below its chrome).
+  // The window's own bounds stay zero-origin to keep frame production alive;
+  // this offset positions the subsurface independently. See CEF issue #2804.
+  gfx::Point subsurface_offset_;
+
+  wl::Object<wl_subsurface> subsurface_;
+
+  // PlatformWindow::Close() may be reached more than once while CEF browser
+  // teardown is pending. Notify the delegate exactly once.
+  bool close_notified_ = false;
+
+  base::WeakPtrFactory<WaylandEmbeddedWindow> weak_ptr_factory_{this};
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_WAYLAND_EMBEDDED_WINDOW_H_
