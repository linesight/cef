diff --git ui/ozone/platform/wayland/host/wayland_embedded_window.cc ui/ozone/platform/wayland/host/wayland_embedded_window.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6b756532a5cc35c383f881eaf2301c0bef4bedcd
--- /dev/null
+++ ui/ozone/platform/wayland/host/wayland_embedded_window.cc
@@ -0,0 +1,237 @@
+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/wayland_embedded_window.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/task/single_thread_task_runner.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/ozone/platform/wayland/common/wayland_object.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+#include "ui/ozone/platform/wayland/host/wayland_output.h"
+#include "ui/ozone/platform/wayland/host/wayland_output_manager.h"
+#include "ui/ozone/platform/wayland/host/wayland_surface.h"
+#include "ui/ozone/platform/wayland/host/wayland_window_manager.h"
+#include "ui/platform_window/platform_window_init_properties.h"
+
+namespace ui {
+
+WaylandEmbeddedWindow::WaylandEmbeddedWindow(PlatformWindowDelegate* delegate,
+                                             WaylandConnection* connection)
+    : WaylandWindow(delegate, connection) {}
+
+void WaylandEmbeddedWindow::Show(bool inactive) {
+  if (subsurface_) {
+    return;
+  }
+  if (!CreateSubsurface()) {
+    // Surface creation normally succeeds after OnInitialize validation. If the
+    // protocol constructor still fails, propagate the failure through the
+    // standard platform-window close path instead of dereferencing a null
+    // wl_subsurface in release builds. Defer Close(): the Views OnClosed path
+    // may synchronously destroy the host and Widget, whose Show() frames are
+    // still active above us.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WaylandEmbeddedWindow::Close,
+                                  weak_ptr_factory_.GetWeakPtr()));
+    return;
+  }
+  WaylandWindow::Show(inactive);
+  // A wl_subsurface receives no server configure event, which is what normally
+  // drives a toplevel to request its initial state and kick viz into producing
+  // the first frame. Do it explicitly now that the subsurface exists (and so
+  // OnSequencePoint won't drop the resulting sequence point).
+  RequestStateFromClient(applied_state());
+}
+
+void WaylandEmbeddedWindow::Hide() {
+  if (!subsurface_) {
+    return;
+  }
+  WaylandWindow::Hide();
+  subsurface_.reset();
+  connection()->Flush();
+}
+
+void WaylandEmbeddedWindow::Close() {
+  if (close_notified_) {
+    return;
+  }
+  close_notified_ = true;
+  WaylandWindow::Close();
+}
+
+WaylandEmbeddedWindow::~WaylandEmbeddedWindow() = default;
+
+bool WaylandEmbeddedWindow::IsVisible() const {
+  return !!subsurface_;
+}
+
+void WaylandEmbeddedWindow::SetBoundsInDIP(const gfx::Rect& bounds_dip) {
+  // The Aura/widget bounds must remain zero-origin. Placement relative to the
+  // external parent belongs exclusively to |subsurface_offset_| and changing
+  // it would additionally require the embedder to commit the parent surface.
+  // A desynchronized child applies buffer/viewport size changes on its own
+  // surface commit, so pure resize must not resend wl_subsurface.set_position.
+  WaylandWindow::SetBoundsInDIP(gfx::Rect(bounds_dip.size()));
+}
+
+void WaylandEmbeddedWindow::OnSequencePoint(int64_t seq) {
+  if (!subsurface_) {
+    return;
+  }
+  ProcessSequencePoint(seq);
+  MaybeApplyLatestStateRequest(/*force=*/false);
+}
+
+base::WeakPtr<WaylandWindow> WaylandEmbeddedWindow::AsWeakPtr() {
+  return weak_ptr_factory_.GetWeakPtr();
+}
+
+float WaylandEmbeddedWindow::EmbeddedScale() const {
+  // Use the compositor's FRACTIONAL per-surface scale (wp_fractional_scale_v1)
+  // so the buffer is painted at the exact device resolution and presented via
+  // wp_viewport (buffer_scale=1, viewport destination = logical size) -- crisp,
+  // 1:1 with the physical display. This mirrors Firefox's MozContainer
+  // subsurface (widget/gtk/WaylandSurface.cpp). A wl_subsurface may not receive
+  // preferred_scale immediately (or at all on some compositors), so fall back
+  // to the primary output's (also fractional) scale. See CEF issue #2804.
+  // Base class returns the raw wp_fractional_scale preferred_scale (null for a
+  // subsurface). NOTE: call the base explicitly -- our override delegates back
+  // here, so calling the virtual would recurse infinitely.
+  if (auto preferred = WaylandWindow::GetPreferredScaleFactor();
+      preferred && *preferred > 0.f) {
+    return *preferred;
+  }
+  if (auto* output_manager = connection()->wayland_output_manager()) {
+    if (auto* output = output_manager->GetPrimaryOutput()) {
+      const float scale = output->scale_factor();
+      if (scale > 0.f) {
+        return scale;
+      }
+    }
+  }
+  return 1.0f;
+}
+
+std::optional<float> WaylandEmbeddedWindow::GetPreferredScaleFactor() const {
+  return EmbeddedScale();
+}
+
+void WaylandEmbeddedWindow::UpdateWindowScale(bool update_bounds) {
+  // Base behavior maps to GetPreferredScaleFactor().value_or(1.0); the 1.0
+  // fallback would be wrong (blurry/undersized) before the subsurface's first
+  // preferred_scale arrives, so route through EmbeddedScale() which falls back
+  // to the output's fractional scale instead. See CEF issue #2804.
+  SetWindowScale(EmbeddedScale());
+}
+
+bool WaylandEmbeddedWindow::OnInitialize(
+    PlatformWindowInitProperties properties,
+    PlatformWindowDelegate::State* state) {
+  external_parent_surface_ =
+      static_cast<wl_surface*>(properties.parent_wayland_surface);
+  if (!connection()->CanCreateSubsurface(external_parent_surface_)) {
+    return false;
+  }
+
+  // Where the subsurface sits within the embedder's content area. The window's
+  // own bounds stay zero-origin (a non-zero origin marks it off-root and
+  // occlusion tracking stops frame production); this offset positions the
+  // subsurface independently. See CEF issue #2804.
+  subsurface_offset_ = properties.wayland_subsurface_offset;
+
+  // An embedded window is always in the normal state.
+  state->window_state = PlatformWindowState::kNormal;
+
+  // Seed the scale so the first buffer is produced at the right resolution
+  // (a wl_subsurface gets no wl_surface.enter, and preferred_scale may arrive
+  // only after the first commit). EmbeddedScale() returns the fractional scale
+  // for crisp wp_viewport-based rendering. See CEF issue #2804.
+  state->window_scale = EmbeddedScale();
+  return true;
+}
+
+bool WaylandEmbeddedWindow::IsSurfaceConfigured() {
+  // A wl_subsurface receives no configure events and is considered configured
+  // as soon as it has a wl_subsurface handle. The external parent surface is
+  // assumed to be mapped by the embedder.
+  return !!subsurface_;
+}
+
+void WaylandEmbeddedWindow::UpdateWindowMask() {
+  // Embedded window has no shape; only update opaqueness.
+  auto region = IsOpaqueWindow() ? std::optional<std::vector<gfx::Rect>>(
+                                       {gfx::Rect(latched_state().size_px)})
+                                 : std::nullopt;
+  root_surface()->set_opaque_region(region);
+}
+
+bool WaylandEmbeddedWindow::CreateSubsurface() {
+  // Parent our root surface to the embedder's external wl_surface.
+  subsurface_ = root_surface()->CreateSubsurface(external_parent_surface_);
+  if (!subsurface_) {
+    return false;
+  }
+
+  SetSubsurfacePosition();
+
+  // The embedded browser has its own ui::Compositor and receives BeginFrames
+  // independently from the host. Desync mode lets our commits become visible
+  // without requiring a parent-surface commit for each frame.
+  wl_subsurface_set_desync(subsurface_.get());
+
+  // Set a genuinely EMPTY input region so the compositor never delivers
+  // pointer/touch to this subsurface. On a shared wl_seat (CEF #2804) GDK also
+  // has a wl_pointer on the same seat; if the pointer enters our subsurface the
+  // compositor sends wl_pointer.enter(our_surface) to GDK too, and GDK crashes
+  // running GDK_IS_WINDOW() on our surface's (non-GObject) user_data.
+  //
+  // NOTE: WaylandSurface::set_input_region() maps an EMPTY vector to a NULL
+  // region == the WHOLE surface (accept all input) -- the opposite of what we
+  // want. A vector holding one zero-size rect instead yields a truly empty
+  // wl_region (CreateAndAddRegion adds a 0x0 area = no pixels). Firefox does
+  // the equivalent in WaylandSurface::DisableUserInputLocked().
+  // TODO(cef #2804): route host seat input to the embedded browser instead of
+  // dropping it (the proper fix); for now the browser renders but is not
+  // pointer-interactive.
+  root_surface()->set_input_region(std::vector<gfx::Rect>{gfx::Rect()});
+
+  // wl_subsurface receives no configure events from the server. As soon as the
+  // handle is created it is considered configured, so the frame manager can
+  // start processing frames.
+  OnSurfaceConfigureEvent();
+
+  // Subsurfaces don't send ack-configure events; notify observers immediately.
+  connection()->window_manager()->NotifyWindowConfigured(this);
+  return true;
+}
+
+void WaylandEmbeddedWindow::SetSubsurfacePosition() {
+  // Position within the embedder's surface, in Wayland DIP coordinates. The
+  // window's bounds are kept zero-origin (see OnInitialize), so the placement
+  // comes from |subsurface_offset_| -- the browser's location inside the host's
+  // content area (e.g. below the host's menu/tool bars).
+  wl_subsurface_set_position(subsurface_.get(), subsurface_offset_.x(),
+                             subsurface_offset_.y());
+
+  // A wl_subsurface's state -- including its initial addition to the parent's
+  // surface tree and its position -- is double-buffered against the PARENT
+  // surface and only applied when the embedder next commits ITS OWN surface.
+  //
+  // We deliberately do NOT commit |external_parent_surface_| here: it is owned
+  // and driven by the embedding toolkit (e.g. GTK/GDK), possibly on another
+  // thread, and committing it from Ozone could prematurely apply the toolkit's
+  // unrelated pending state (attached buffer, damage, viewport, input region,
+  // frame callbacks) or race the toolkit's own commit. Instead the embedder is
+  // responsible for committing its surface to latch our changes -- e.g. by
+  // invalidating its GDK window, which is what Firefox does in
+  // MozContainerWayland (widget/gtk). We only flush so our own batched requests
+  // (get_subsurface/set_position/attach/...) reach the server before that
+  // parent commit arrives. See CEF issue #2804.
+  connection()->Flush();
+}
+
+}  // namespace ui
