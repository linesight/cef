+TEST_P(WaylandWindowTest, EmbeddedResize) {
+  constexpr gfx::Rect kInitialBounds(800, 528);
+  constexpr gfx::Size kResizedSize(320, 240);
+  constexpr gfx::Point kSubsurfaceOffset(7, 72);
+
+  testing::NiceMock<MockWaylandPlatformWindowDelegate> embedded_delegate(
+      connection_.get());
+  ON_CALL(embedded_delegate, GetMinimumSizeForWindow())
+      .WillByDefault(Return(gfx::Size(1, 1)));
+
+  auto external_parent = connection_->CreateSurface();
+  ASSERT_TRUE(external_parent);
+  const uint32_t external_parent_id =
+      wl_proxy_get_id(reinterpret_cast<wl_proxy*>(external_parent.get()));
+
+  PlatformWindowInitProperties properties(kInitialBounds);
+  properties.type = PlatformWindowType::kWindow;
+  properties.parent_wayland_surface = external_parent.get();
+  properties.wayland_subsurface_offset = kSubsurfaceOffset;
+  auto embedded = embedded_delegate.CreateWaylandWindow(connection_.get(),
+                                                        std::move(properties));
+  ASSERT_TRUE(embedded);
+
+  const uint32_t embedded_surface_id =
+      embedded->root_surface()->get_surface_id();
+  embedded->Show(/*inactive=*/false);
+  connection_->Flush();
+
+  PostToServerAndWait([external_parent_id, embedded_surface_id,
+                       subsurface_offset = kSubsurfaceOffset](
+                          wl::TestWaylandServerThread* server) {
+    auto* external_parent =
+        server->GetObject<wl::MockSurface>(external_parent_id);
+    auto* embedded_surface =
+        server->GetObject<wl::MockSurface>(embedded_surface_id);
+    ASSERT_TRUE(external_parent);
+    ASSERT_TRUE(embedded_surface);
+    auto* subsurface = embedded_surface->sub_surface();
+    ASSERT_TRUE(subsurface);
+    EXPECT_EQ(external_parent->resource(), subsurface->parent_resource());
+    EXPECT_EQ(gfx::PointF(subsurface_offset), subsurface->position());
+
+    Mock::VerifyAndClearExpectations(external_parent);
+    Mock::VerifyAndClearExpectations(embedded_surface);
+    Mock::VerifyAndClearExpectations(subsurface);
+    EXPECT_CALL(*external_parent, Commit()).Times(0);
+    EXPECT_CALL(*subsurface, SetPosition(_, _)).Times(0);
+    EXPECT_CALL(*embedded_surface, Commit()).Times(1);
+  });
+
+  // Deliberately pass a non-zero origin to verify that embedded Widget/Aura
+  // bounds remain zero-origin. Runtime placement is stored independently in
+  // the wl_subsurface offset.
+  embedded->SetBoundsInDIP(gfx::Rect(gfx::Point(100, 200), kResizedSize));
+  EXPECT_EQ(gfx::Rect(kResizedSize), embedded->GetBoundsInDIP());
+
+  const gfx::Size resized_size_px = embedded->applied_state().size_px;
+  CreateBufferAndPresentAsNewFrame(embedded.get(), embedded_delegate,
+                                   resized_size_px,
+                                   embedded->applied_state().window_scale);
+
+  PostToServerAndWait([external_parent_id, embedded_surface_id,
+                       subsurface_offset = kSubsurfaceOffset](
+                          wl::TestWaylandServerThread* server) {
+    auto* external_parent =
+        server->GetObject<wl::MockSurface>(external_parent_id);
+    auto* embedded_surface =
+        server->GetObject<wl::MockSurface>(embedded_surface_id);
+    ASSERT_TRUE(external_parent);
+    ASSERT_TRUE(embedded_surface);
+    auto* subsurface = embedded_surface->sub_surface();
+    ASSERT_TRUE(subsurface);
+    EXPECT_EQ(gfx::PointF(subsurface_offset), subsurface->position());
+    Mock::VerifyAndClearExpectations(external_parent);
+    Mock::VerifyAndClearExpectations(embedded_surface);
+    Mock::VerifyAndClearExpectations(subsurface);
+  });
+
+  EXPECT_EQ(gfx::Rect(kResizedSize), embedded->latched_state().bounds_dip);
+  EXPECT_EQ(resized_size_px, embedded->latched_state().size_px);
+}
+
+TEST_P(WaylandWindowTest, EmbeddedRejectsInvalidParentSurface) {
+  EXPECT_FALSE(connection_->CanCreateSubsurface(nullptr));
+
+  int sockets[2];
+  ASSERT_EQ(0, socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets));
+  base::ScopedFD unused_server_socket(sockets[1]);
+  wl_display* foreign_display = wl_display_connect_to_fd(sockets[0]);
+  ASSERT_TRUE(foreign_display);
+  wl_proxy* foreign_surface = wl_proxy_create(
+      reinterpret_cast<wl_proxy*>(foreign_display), &wl_surface_interface);
+  ASSERT_TRUE(foreign_surface);
+
+  EXPECT_FALSE(connection_->CanCreateSubsurface(
+      reinterpret_cast<wl_surface*>(foreign_surface)));
+
+  PlatformWindowInitProperties properties(gfx::Rect(800, 528));
+  properties.type = PlatformWindowType::kWindow;
+  properties.parent_wayland_surface = foreign_surface;
+  EXPECT_FALSE(WaylandWindow::Create(&delegate_, connection_.get(),
+                                     std::move(properties)));
+
+  wl_proxy_destroy(foreign_surface);
+  wl_display_disconnect(foreign_display);
+}
